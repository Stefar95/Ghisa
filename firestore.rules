rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "projectste2026@gmail.com";
    }

    function isPT() {
      return request.auth != null
        && exists(/databases/$(database)/documents/directory/$(request.auth.uid))
        && get(/databases/$(database)/documents/directory/$(request.auth.uid)).data.isPT == true;
    }

    // Vale per le regole sulla collection "schede" più sotto: chi la
    // possiede o chi ce l'ha assegnata può leggerla/scriverla.
    function isSchedaMember() {
      return request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.uid in resource.data.assignedToUids)
      );
    }

    // Anagrafica esercizi: uguale per tutti
    match /shared/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allenamenti e bozza: privati di ogni utente (le schede, invece, sono
    // nella collection "schede" più sotto, condivisa con chi te le assegna).
    // Il PT può solo leggere (serve per il conteggio totale allenamenti
    // nell'Anagrafica esercizi), non scrivere.
    match /users/{userId} {
      allow read: if isAdmin() || isPT() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Elenco utenti e ruoli
    match /directory/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || isAdmin() || isPT()
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid || isAdmin()
      );
    }

    // Schede: un documento unico per scheda (non più una copia per utente).
    // Chi la possiede (ownerUid) e chi ce l'ha assegnata (assignedToUids)
    // leggono e scrivono lo STESSO documento, quindi le modifiche di uno
    // sono subito visibili all'altro. L'eliminazione resta riservata a chi
    // l'ha creata (o all'admin), per non far sparire una scheda a chi l'ha
    // solo ricevuta.
    match /schede/{schedaId} {
      allow read, update: if isAdmin() || isSchedaMember();
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }
  }
}
